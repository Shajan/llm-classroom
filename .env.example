# Copy this file to .env (in this same folder) and fill in your keys:
#   cp .env.example .env
# .env is in .gitignore, so your keys are never committed.

# Required: used by every lesson.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: LangSmith tracing (3.MCP), to see each model and tool call.
# Get a key at https://smith.langchain.com (Settings > API Keys).
# Leave it empty to keep tracing off.
LANGSMITH_API_KEY=
